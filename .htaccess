<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # 1. Prevent access to hidden files and directories (except .well-known for SSL verification)
    RewriteRule (^|/)\.(?!well-known) - [F,L,NC]

    # 2. Block access to sensitive application source directories
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor|scratch)/ - [F,L,NC]

    # 3. Block access to sensitive root-level files and database dumps
    RewriteRule ^(composer\.(json|lock)|package(-lock)?\.json|artisan|vite\.config\.js|\.env.*|.*\.sql|.*\.log)$ - [F,L,NC]

    # 4. Redirect all web requests to the public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
